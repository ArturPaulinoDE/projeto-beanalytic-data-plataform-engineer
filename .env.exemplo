# Configurações do Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE=apache/airflow:2.8.1-python3.10
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_LOGGING_LEVEL=INFO
AIRFLOW_WEBSERVER_PORT=8080

# Requisitos Python adicionais a serem instalados no Airflow
AIRFLOW_PIP_ADDITIONAL_REQUIREMENTS=pandas>=2.0.0 pyarrow>=12.0.0 requests>=2.31.0 great-expectations>=0.18.0

# Administrador do Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_ROLE=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=admin_password_here

# Banco de Dados Postgres
POSTGRES_IMAGE=postgres:13
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_password_here
POSTGRES_DB=airflow
# Porta do Postgres exposta para conexões externas
POSTGRES_PORT=5432
